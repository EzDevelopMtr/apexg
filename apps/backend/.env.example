# Copiar a apps/backend/.env y rellenar con valores reales.
# apps/backend/.env está gitignored — NUNCA versionar valores reales.

# Cadena de conexión de PostgreSQL (Supabase session pooler, puerto 5432).
DATABASE_URL=

# Secreto para firmar los access tokens JWT. Debe ser una cadena larga y
# aleatoria. El backend NO arranca si falta. DISTINTO en cada entorno
# (desarrollo, pruebas, producción): con el mismo, una sesión abierta en uno
# vale en los otros.
JWT_ACCESS_SECRET=

# Puerto HTTP del backend.
PORT=3001
